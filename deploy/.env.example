# Bind the frontend to localhost by default. Use 8080:8080 to expose it on all interfaces.
METAWORKS_FRONTEND_BIND=127.0.0.1:8080:8080

# Keep release-image runs inside the backend container's conda environment by default.
METAWORKS_ALLOWED_RUNTIMES=conda

# Include Vite development origins for source development against the same backend settings.
METAWORKS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
